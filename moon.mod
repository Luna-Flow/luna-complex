name = "Luna-Flow/luna-complex"

version = "0.2.0"

import {
  "Luna-Flow/arithmetic@0.2.2",
  "Kaida-Amethyst/math@0.1.20",
  "Luna-Flow/luna-generic@0.3.3",
}

readme = "README.md"

repository = "https://github.com/Luna-Flow/luna-complex"

license = "Apache-2.0"

keywords = [ "complex-numbers", "math" ]

description = "Generic complex-number types and algebraic operations for LunaFlow, with floating analytic backend functions in the float_backend subpackage."

source = "src"
