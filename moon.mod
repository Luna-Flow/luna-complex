name = "Luna-Flow/luna-complex"

version = "0.2.0"

import {
  "Kaida-Amethyst/math@0.1.20",
  "Luna-Flow/luna-generic@0.3.1",
  "Luna-Flow/arithmetic@0.1.0",
}

readme = "README.md"

repository = "https://github.com/Luna-Flow/luna-complex"

license = "Apache-2.0"

keywords = [ "complex-numbers", "math" ]

description = "Generic complex-number types and algebraic operations for LunaFlow, with Double-specific analytic functions in the double_ext subpackage."

options(
  source: "src",
)
